# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Build / env
.venv/
/dist/
/build/
build-tmp/
*.egg-info/

# Local config (publish the *.example.json files instead)
config.json
config.system.json

# Caches
.pytest_cache/
.ruff_cache/

# The two data trees this install writes (see mediaconductor/layout.py):
#   data/    everything downloaded or generated — delete it to start fresh
#   runtime/ AI tool envs, HF/torch/uv caches, install state, OAuth tokens
/data/
/runtime/

# Generated output
*.log
*.err
*.out

# User content and local media (yours, kept outside data/ so a reset spares it)
/bgm/
/fonts/
/background_image/
/vocal/
/thumbnail/

# External AI tools are sibling uv projects, not vendored here
/kokoro-82m/
/index-tts/
/magi-v3/
/deepseek-ocr2/
/z-image-turbo/

# Isolated dev tooling (e.g. portable Node.js) — not vendored, not global
/.tools/

# Editor / assistant local state — but the shipped agent skills are source
.claude/*
!.claude/skills/
.idea/
.vscode/
